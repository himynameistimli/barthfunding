---
import s from "../styles/app.module.scss";
import ViewToggle from "./ViewToggle.astro";
import { LAST_UPDATED } from "../data/programs.mjs";

// headlineNote defaults to the index's award-total explainer; other pages that
// set a headline should pass their own.
// `view` is "index" | "calendar" | undefined — undefined on pages that are
// neither, where the toggle renders as two plain links.
const {
  headline,
  headlineNote = "Max single-award total across capped programs still open. Uncapped and in-kind mechanisms add more.",
  showFilters = false,
  view
} = Astro.props;
// On the calendar the on-page subscribe row already reflects the filter.
const showSubscribe = showFilters && view !== "calendar";
---
<aside class={s.rail}>
  <div>
    <div class={s.brandRow}>
      <a href="/" class={s.brandLink}>
        <div class={s.brandA}>Barth Syndrome</div>
        <div class={s.brandB}>Research Funding Index</div>
      </a>
    </div>
    <ViewToggle view={view} />
    {headline && (
      <>
        <div class={s.headline}>{headline}</div>
        {headlineNote && <p class={s.headlineNote}>{headlineNote}</p>}
      </>
    )}
  </div>

  {showFilters && (
    <>
      <div>
        <input type="search" id="q" class={s.search} placeholder="Search the index…" aria-label="Search funding programs" />
        <p class={s.count} id="count"></p>
        <button class={s.filtersToggle} id="filters-toggle" type="button" aria-controls="filter-groups" aria-expanded="false">Filters</button>
      </div>
      <button class={s.filterScrim} id="filter-scrim" aria-label="Close filters" type="button"></button>
      {showSubscribe && (
        <a class={s.railSub} id="rail-sub" href="/calendar/">
          <span class={s.railSubHead}>Subscribe to this view</span>
          <span class={s.railSubN} id="rail-sub-n"></span>
        </a>
      )}
      <div class={s.filterGroups} id="filter-groups">
        <button class={s.filtersClose} id="filters-close" type="button">Done ✕</button>
        <div>
          <div class={s.railHead}>Funder</div>
          <div class={s.railList} id="cat-filters"></div>
        </div>
        <div>
          <div class={s.railHead}>Audience</div>
          <div class={s.railList} id="aud-filters"></div>
        </div>
        <div>
          <div class={s.railHead}>Award</div>
          <div class={s.railList} id="type-filters"></div>
        </div>
        <div>
          <div class={s.railHead}>Focus</div>
          <div class={s.railList} id="focus-filters"></div>
        </div>
        <div>
          <div class={s.railHead}>Status</div>
          <div class={s.railList} id="status-filters"></div>
        </div>
      </div>
    </>
  )}

  <div class={s.railFoot}>
    Last updated {LAST_UPDATED}.<br />Confirm details on the funder's site before applying.
    <a class={s.railFootLink} href="/suggest-update/">Suggest an edit</a>
  </div>
</aside>

{showFilters && (
  <script define:vars={{ s }}>
    // The mobile filter slide-over belongs to the rail, so any page that asks
    // for filters gets it. It used to live in the index's script, which is why
    // the calendar's drawer would not open.
    const groups = document.getElementById("filter-groups");
    const scrim = document.getElementById("filter-scrim");
    const toggle = document.getElementById("filters-toggle");
    const close = () => {
      groups.classList.remove(s.open);
      scrim.classList.remove(s.open);
      toggle.setAttribute("aria-expanded", "false");
    };
    toggle?.addEventListener("click", () => {
      groups.classList.add(s.open);
      scrim.classList.add(s.open);
      toggle.setAttribute("aria-expanded", "true");
    });
    scrim?.addEventListener("click", close);
    document.getElementById("filters-close")?.addEventListener("click", close);
  </script>
)}
