---
// Switch between the two views of the same dataset. `view` is "index" | "calendar".
import s from "../styles/app.module.scss";

const { view } = Astro.props;

const VIEWS = [
  { key: "index", href: "/", label: "Index" },
  { key: "calendar", href: "/calendar/", label: "Calendar" }
];
---
<div class={s.viewToggle} role="group" aria-label="View">
  {VIEWS.map(v => (
    v.key === view ? (
      <span class={`${s.viewOpt} ${s.viewOptOn}`} aria-current="page">{v.label}</span>
    ) : (
      <a class={s.viewOpt} href={v.href}>{v.label}</a>
    )
  ))}
</div>
