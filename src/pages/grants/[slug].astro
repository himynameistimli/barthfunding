---
import Base from "../../layouts/Base.astro";
import Rail from "../../components/Rail.astro";
import s from "../../styles/app.module.scss";
import { PROGRAMS, LAST_UPDATED, TYPE_LABELS, FOCUS_LABELS } from "../../data/programs.mjs";
import { CONTACT_EMAIL } from "../../data/site.mjs";

export function getStaticPaths() {
  return PROGRAMS.map(p => ({ params: { slug: p.slug }, props: { program: p } }));
}

const CAT_META = {
  government: { code: "GOV", label: "Government" },
  nonprofit: { code: "FDN", label: "Foundation / non-profit" },
  corporate: { code: "CORP", label: "Corporate / industry" },
  general: { code: "GEN", label: "General biomedical" }
};

const { program: p } = Astro.props;
const meta = CAT_META[p.cat] || { code: "—", label: "" };
const srcClass = s["src" + p.cat.charAt(0).toUpperCase() + p.cat.slice(1)];
const permalinkPath = `/grants/${p.slug}/`;
const mailto = `mailto:${CONTACT_EMAIL}?subject=${encodeURIComponent(`Funding directory update: ${p.name}`)}`;
---
<Base title={`${p.name} — Barth Syndrome Research Funding`} description={p.desc.slice(0, 155)}>
  <div class={s.shell}>
    <Rail />
    <main class={s.doc}>
      <p class={s.crumb}><a href="/">← Funding index</a></p>
      <span class={`${s.drawerCat} ${srcClass}`}>{meta.code} — {meta.label.toUpperCase()}</span>
      <h1>{p.name}</h1>
      <p class={s.sponsor}>{p.sponsor}</p>

      {p.expired && (
        <div class={s.pastBanner}>
          <strong>This application window has closed.</strong> The entry is kept for reference — check the funder's page below for a future cycle. It is hidden from the index unless “Include past programs” is on.
        </div>
      )}

      <div class={s.facts}>
        <div class={s.fact}><div class={s.factK}>Award</div><div class={s.factV}>{p.amount || "—"}</div></div>
        <div class={s.fact}><div class={s.factK}>Deadline</div><div class={s.factV}>{p.deadline || "—"}</div></div>
        <div class={s.fact}><div class={s.factK}>Award type</div><div class={s.factV}>{TYPE_LABELS[p.awardType] || "—"}</div></div>
        <div class={s.fact}><div class={s.factK}>Focus</div><div class={s.factV}>{(p.focus || []).map(f => FOCUS_LABELS[f]).join(" · ") || "—"}</div></div>
      </div>

      <p class={s.lede}>{p.desc}</p>

      <div class={s.sec}><div class={s.secH}>Who can apply</div><p>{p.eligibility}</p></div>
      <div class={s.sec}><div class={s.secH}>How to apply</div><p>{p.apply}</p></div>
      <div class={s.sec}>
        <div class={s.secH}>Links &amp; downloads</div>
        <div class={s.links}>
          {(p.links || []).map(l => <a href={l.url} target="_blank" rel="noopener">{l.label} ↗</a>)}
        </div>
      </div>

      {p.tags?.length > 0 && (
        <div class={s.sec}>
          <div class={s.secH}>Tags</div>
          <div class={s.tagRow}>
            {p.tags.map(t => <a href={`/?q=${encodeURIComponent(t)}`}>{t}</a>)}
          </div>
        </div>
      )}

      <div class={s.sec}>
        <div class={s.secH}>Permalink</div>
        <p class={s.mono} id="permalink">{permalinkPath}</p>
        <p style="margin-top: 8px;">
          <button class={s.drawerClose} id="copy-link" type="button" style="border: 1px solid var(--ink); padding: 5px 10px;">Copy link</button>
        </p>
      </div>

      <p class={s.docFoot}>
        Last updated {LAST_UPDATED} · <a href={mailto}>Suggest an update to this entry</a>
      </p>
    </main>
  </div>

  <script>
    const code = document.getElementById("permalink");
    if (code) code.textContent = window.location.href;
    const btn = document.getElementById("copy-link");
    btn?.addEventListener("click", async () => {
      await navigator.clipboard.writeText(window.location.href);
      btn.textContent = "Copied";
      setTimeout(() => (btn.textContent = "Copy link"), 1500);
    });
  </script>
</Base>
