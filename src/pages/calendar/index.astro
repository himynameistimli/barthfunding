---
import Base from "../../layouts/Base.astro";
import Rail from "../../components/Rail.astro";
import { LAST_UPDATED } from "../../data/programs.mjs";
import { SITE_URL, CONTACT_EMAIL } from "../../data/site.mjs";
import {
  AUDIENCES, ENTRIES, entriesFor, rollingFor, groupByMonth,
  formatDate, formatTime, KIND_LABEL, isSoft
} from "../../data/calendar.mjs";
import a from "../../styles/app.module.scss";
import c from "../../styles/calendar.module.scss";

const verified = ENTRIES.filter(e => e.status === "verified").length;
const unconfirmed = ENTRIES.filter(e => e.status === "unconfirmed").length;
const projected = ENTRIES.filter(e => e.status === "projected").length;
const in2027 = ENTRIES.filter(e => e.year === 2027).length;
const withDates = new Set(ENTRIES.map(e => e.slug)).size;
// webcal:// hands the feed to the OS calendar handler, so it wants a bare host.
const SITE_HOST = SITE_URL.replace(/^https?:\/\//, "");

const sections = AUDIENCES.map(aud => {
  const entries = entriesFor(aud.key);
  return {
    ...aud,
    entries,
    months: groupByMonth(entries),
    rolling: rollingFor(aud.key),
    feed: `${SITE_URL}/calendar/${aud.key}.ics`
  };
});

const FEEDS = [
  { key: "all", label: "Everything", name: "Barth funding deadlines", n: ENTRIES.length },
  ...AUDIENCES.map(x => ({
    key: x.key,
    label: x.label,
    name: `Barth funding — ${x.label.toLowerCase()}`,
    n: entriesFor(x.key).length
  }))
];

// Only entries you act on; decisions and award starts are context, not tasks.
const actionable = ENTRIES.filter(e => !isSoft(e));

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Barth syndrome funding deadline calendar",
  url: `${SITE_URL}/calendar/`,
  description:
    "Every dated deadline across Barth syndrome and rare-disease research funding, separated by audience, with subscribable calendar feeds.",
  isPartOf: { "@type": "WebSite", name: "Barth Syndrome Research Funding Index", url: SITE_URL }
};
---
<Base
  title="Funding deadline calendar — Barth syndrome research funding"
  description="Every dated funding deadline through 2027 for Barth syndrome research, advocacy organizations, and families — with subscribable .ics calendar feeds that set their own reminders."
  jsonLd={jsonLd}
>
  <div class={a.shell}>
    <Rail
      headline={`${ENTRIES.length} dated entries`}
      view="calendar"
      headlineNote={`Across ${withDates} programs — ${verified} read off the funder's own page, ${unconfirmed} published but unconfirmed, ${projected} projected from past cycles.`}
    />

    <main class={`${a.doc} ${a.docWide} ${c.page}`}>
      <h1>Funding deadline calendar</h1>

      <p class={c.lede}>
        Every tracked deadline, letter of intent, opening date, and decision, in order and
        split by who it is for. {in2027} of {ENTRIES.length} fall in 2027.
      </p>

      <section class={c.subscribe}>
        <h2 class={c.subHead}>Subscribe</h2>
        <p class={c.subNote}>
          Pick a list, then your calendar. The subscription updates itself as we correct
          dates, and every deadline brings its own reminders.
        </p>

        <div class={c.feedPick} role="group" aria-label="Which list">
          {FEEDS.map((f, i) => (
            <button
              class={c.chip}
              type="button"
              data-feed={f.key}
              data-name={f.name}
              aria-pressed={i === 0 ? "true" : "false"}
            >
              <span>{f.label}</span><span class={c.chipN}>{f.n}</span>
            </button>
          ))}
        </div>

        <div class={c.addRow}>
          <span class={c.ctrlLabel}>Add to</span>
          <a class={c.addBtn} id="add-google" href="#" target="_blank" rel="noopener">Google Calendar</a>
          <a class={c.addBtn} id="add-apple" href="#">Apple Calendar</a>
          <a class={c.addBtn} id="add-outlook" href="#" target="_blank" rel="noopener">Outlook.com</a>
          <a class={c.addBtn} id="add-m365" href="#" target="_blank" rel="noopener">Microsoft 365</a>
          <a class={c.addBtnAlt} id="add-download" href="#" download>Download .ics</a>
          <button class={c.addBtnAlt} type="button" id="add-copy">Copy link</button>
        </div>

        <p class={c.subHint} aria-live="polite" id="copy-status">
          Google and Outlook open in a new tab and ask you to confirm. Apple Calendar opens
          the app on your Mac or iPhone. Anything else — copy the link and add it as a
          calendar “from URL”.
        </p>
      </section>

      <section class={c.actNow} id="act-now">
        <h2 class={c.subHead}>What to do next</h2>
        <p class={c.subNote} id="act-intro">The soonest dates you can still act on.</p>
        <ul class={c.actList} id="act-list"></ul>
        <p class={c.empty} id="act-empty" hidden>
          Nothing in the next stretch. Scroll on for what is coming later.
        </p>
      </section>

      <div class={c.controls}>
        <span class={c.ctrlLabel}>Show</span>
        <button class={c.chip} type="button" data-year="all" aria-pressed="true">All</button>
        <button class={c.chip} type="button" data-year="2026" aria-pressed="false">Rest of 2026</button>
        <button class={c.chip} type="button" data-year="2027" aria-pressed="false">2027</button>
        <button class={c.chip} type="button" data-year="2028" aria-pressed="false">2028+</button>
        <span class={c.spacer}></span>
        <button class={c.chip} type="button" id="toggle-past" aria-pressed="false">Include past dates</button>
        <button class={c.chip} type="button" id="toggle-verified" aria-pressed="false">Verified dates only</button>
      </div>

      {sections.map(sec => (
        <section class={c.audSection} id={sec.key}>
          <div class={c.audHead}>
            <h2 class={c.audTitle}>{sec.label}</h2>
            <span class={c.audCount}>
              <span data-count-for={sec.key}>{sec.entries.length}</span> dated ·{" "}
              <a class={c.audSub} href={`/calendar/${sec.key}.ics`}>subscribe .ics</a>
            </span>
          </div>
          <p class={c.audBlurb}>{sec.blurb}</p>

          {sec.months.map(mon => (
            <>
              <h3 class={c.monthHead} data-month={mon.key}>{mon.label}</h3>
              {mon.entries.map(e => (
                <article
                  class={c.entry}
                  data-on={e.on}
                  data-year={e.year}
                  data-status={e.status}
                  data-soft={isSoft(e) ? "1" : "0"}
                  data-aud={sec.key}
                  data-program={e.program}
                  data-label={e.label}
                  data-href={`/grants/${e.slug}/`}
                  data-when={formatDate(e)}
                >
                  <div class={c.when}>
                    {formatDate(e)}
                    {formatTime(e) && <span class={c.whenTime}>{formatTime(e)}</span>}
                    <span class={c.days} data-days></span>
                  </div>
                  <div class={c.body}>
                    <p class={c.prog}><a href={`/grants/${e.slug}/`}>{e.program}</a></p>
                    <p class={c.what}>{e.label}</p>
                    {e.note && <p class={c.note}>{e.note}</p>}
                  </div>
                  <div class={c.flags}>
                    <span class={`${c.tag} ${c.tagKind}`}>{KIND_LABEL[e.kind]}</span>
                    {e.expired && <span class={`${c.tag} ${c.tagWatch}`}>Watch</span>}
                    <span
                      class={`${c.tag} ${
                        e.status === "verified" ? c.tagVerified
                        : e.status === "unconfirmed" ? c.tagUnconfirmed
                        : c.tagProjected
                      }`}
                      title={e.status === "verified" ? `Confirmed on ${e.source} on ${e.checked}` : undefined}
                    >
                      {e.status === "verified" ? "Verified"
                        : e.status === "unconfirmed" ? "Unconfirmed" : "Projected"}
                    </span>
                  </div>
                </article>
              ))}
            </>
          ))}

          {sec.rolling.length > 0 && (
            <div class={c.rolling}>
              <h3 class={c.subHead}>
                No deadline to track — {sec.rolling.length} rolling {sec.rolling.length === 1 ? "program" : "programs"}
              </h3>
              <p class={c.subNote}>
                {sec.key === "patients"
                  ? "Nearly all family assistance runs on rolling intake: there is no date to diarise, you apply at the point of need. These are the ones to know about before you need them."
                  : "These accept applications year-round or on request, so they never appear on a calendar. Worth a look when you are between deadlines."}
              </p>
              <ul class={c.rollingList}>
                {sec.rolling.map(p => (
                  <li class={c.rollingItem}>
                    <a href={`/grants/${p.slug}/`}>{p.name}</a>
                    <span>{p.deadline}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </section>
      ))}

      <section class={c.legend}>
        <h2>How to read this</h2>
        <div class={c.legendGrid}>
          <p class={c.legendItem}>
            <strong>Verified ({verified})</strong>
            Read directly off the funder's own page on {LAST_UPDATED}. The calendar entry
            records which page, so you can check our work.
          </p>
          <p class={c.legendItem}>
            <strong>Unconfirmed ({unconfirmed})</strong>
            A real published date that we have not confirmed at the source — either the
            funder's own page was unreachable and we are relying on others reporting it, or
            the date came from an earlier pass of this index and has not been re-checked.
          </p>
          <p class={c.legendItem}>
            <strong>Projected ({projected})</strong>
            Inferred from the program's past cycles. The funder has not published this date.
            Treat it as a prompt to go and check, never as a deadline.
          </p>
          <p class={c.legendItem}>
            <strong>Watch</strong>
            The program has no open call right now. The date is our best guess at when it
            reopens.
          </p>
          <p class={c.legendItem}>
            <strong>NIH dates</strong>
            Standing receipt dates, already shifted off weekends and federal holidays to the
            next business day, as NIH policy requires.
          </p>
        </div>
        <p class={a.note}>
          A program can appear under more than one audience when it genuinely serves both.
          Dates move, and calls are cancelled without notice — confirm on the funder's own
          site before you rely on anything here. Corrections go to{" "}
          <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a> or the{" "}
          <a href="/suggest-update/">suggest an update</a> page.
        </p>
        <p class={a.docFoot}>Deadline data last verified {LAST_UPDATED}.</p>
      </section>
    </main>
  </div>
</Base>

<script define:vars={{ c, SITE_URL, SITE_HOST, actionable: actionable.map(e => ({
  on: e.on, program: e.program, label: e.label, slug: e.slug,
  status: e.status, when: formatDate(e), precision: e.precision
})) }}>
  // The site is statically built, so "today" has to be decided in the browser —
  // otherwise a stale build would show past deadlines as upcoming.
  const today = new Date();
  today.setHours(0, 0, 0, 0);
  const iso = d => d.toISOString().slice(0, 10);
  const todayISO = iso(today);
  const dayDiff = on => {
    const [y, m, d] = on.split("-").map(Number);
    return Math.round((Date.UTC(y, m - 1, d) - Date.UTC(
      today.getFullYear(), today.getMonth(), today.getDate())) / 86400000);
  };

  const plural = (n, w) => `${n} ${w}${n === 1 ? "" : "s"}`;
  const relative = n => {
    if (n === 0) return "today";
    if (n < 0) return `${plural(-n, "day")} ago`;
    if (n === 1) return "tomorrow";
    if (n < 45) return `in ${plural(n, "day")}`;
    const months = Math.round(n / 30.4);
    return `in ${plural(months, "month")}`;
  };

  // --- subscribe targets ----------------------------------------------------
  // webcal:// only works when an app is registered for that protocol, so the
  // browser-based calendars need their own add-by-URL endpoints instead.
  const copyStatus = document.getElementById("copy-status");
  const statusDefault = copyStatus.textContent;
  const copyBtn = document.getElementById("add-copy");
  const copyDefault = copyBtn.textContent;

  let feed = "all";
  let feedName = document.querySelector("[data-feed]").dataset.name;

  function feedUrls() {
    const https = `${SITE_URL}/calendar/${feed}.ics`;
    const webcal = `webcal://${SITE_HOST}/calendar/${feed}.ics`;
    return {
      https,
      webcal,
      // Google takes the feed as `cid`; the webcal form is what it expects.
      google: `https://calendar.google.com/calendar/r?cid=${encodeURIComponent(webcal)}`,
      // Same add-by-URL route, but personal and work/school accounts live on
      // different hosts — one button would fail for half of Outlook users.
      outlook:
        "https://outlook.live.com/calendar/0/addfromweb?url=" +
        encodeURIComponent(https) + "&name=" + encodeURIComponent(feedName),
      m365:
        "https://outlook.office.com/calendar/0/addfromweb?url=" +
        encodeURIComponent(https) + "&name=" + encodeURIComponent(feedName)
    };
  }

  function syncTargets() {
    const u = feedUrls();
    document.getElementById("add-google").href = u.google;
    document.getElementById("add-apple").href = u.webcal;
    document.getElementById("add-outlook").href = u.outlook;
    document.getElementById("add-m365").href = u.m365;
    const dl = document.getElementById("add-download");
    dl.href = u.https;
    dl.setAttribute("download", `barth-funding-${feed}.ics`);
  }

  for (const btn of document.querySelectorAll("[data-feed]")) {
    btn.addEventListener("click", () => {
      feed = btn.dataset.feed;
      feedName = btn.dataset.name;
      for (const b of document.querySelectorAll("[data-feed]")) {
        b.setAttribute("aria-pressed", String(b === btn));
      }
      syncTargets();
      copyBtn.textContent = copyDefault;
      copyStatus.textContent = statusDefault;
    });
  }
  syncTargets();

  async function copyText(text) {
    try {
      await navigator.clipboard.writeText(text);
      return true;
    } catch {
      // Older browsers, and any context where the async clipboard is blocked.
      const ta = document.createElement("textarea");
      ta.value = text;
      ta.setAttribute("readonly", "");
      ta.style.cssText = "position:fixed;top:-1000px;opacity:0";
      document.body.appendChild(ta);
      ta.select();
      let ok = false;
      try { ok = document.execCommand("copy"); } catch { ok = false; }
      ta.remove();
      return ok;
    }
  }

  let resetTimer;
  copyBtn.addEventListener("click", async () => {
    const url = feedUrls().https;
    const ok = await copyText(url);
    clearTimeout(resetTimer);
    copyBtn.textContent = ok ? "Copied \u2713" : "Select it below";
    copyStatus.textContent = "";

    if (ok) {
      copyStatus.textContent =
        `Copied ${url} — paste it into your calendar app as a new subscription.`;
    } else {
      // Clipboard access can be blocked outright. Put the address on the page
      // and select it, so the keyboard shortcut has something to act on.
      copyStatus.append("Copy this address: ");
      const code = document.createElement("code");
      code.textContent = url;
      copyStatus.append(code);
      const range = document.createRange();
      range.selectNodeContents(code);
      const sel = window.getSelection();
      sel.removeAllRanges();
      sel.addRange(range);
    }

    resetTimer = setTimeout(() => {
      copyBtn.textContent = copyDefault;
      copyStatus.textContent = statusDefault;
    }, 8000);
  });

  // --- "what to do next" ----------------------------------------------------
  const upcoming = actionable
    .filter(e => e.on >= todayISO)
    .sort((a, b) => (a.on < b.on ? -1 : 1))
    .slice(0, 8);

  const list = document.getElementById("act-list");
  const empty = document.getElementById("act-empty");
  if (!upcoming.length) {
    empty.hidden = false;
  } else {
    list.innerHTML = upcoming.map(e => {
      const n = dayDiff(e.on);
      const soon = n <= 21;
      const mark = e.status === "projected" ? " (projected)" : "";
      return `<li class="${c.actItem}">
        <span class="${c.actDays} ${soon ? c.actSoon : ""}">${relative(n)}</span>
        <span><a href="/grants/${e.slug}/">${e.program}</a> — ${e.label}${mark}
          <span class="${c.actWhen}">${e.when}</span></span>
      </li>`;
    }).join("");
  }

  // --- per-row day counts ---------------------------------------------------
  const rows = [...document.querySelectorAll("article[data-on]")];
  for (const row of rows) {
    const on = row.dataset.on;
    const n = dayDiff(on);
    const slot = row.querySelector("[data-days]");
    if (slot) {
      slot.textContent = relative(n);
      if (n < 0) slot.classList.add(c.daysPast);
    }
    row.dataset.past = n < 0 ? "1" : "0";
  }

  // --- filters --------------------------------------------------------------
  let year = "all";
  let showPast = false;
  let verifiedOnly = false;

  function apply() {
    for (const row of rows) {
      const y = row.dataset.year;
      const yearOk = year === "all"
        || (year === "2028" ? Number(y) >= 2028 : y === year);
      const pastOk = showPast || row.dataset.past === "0";
      const statusOk = !verifiedOnly || row.dataset.status === "verified";
      const show = yearOk && pastOk && statusOk;
      row.hidden = !show;
      row.classList.toggle(c.entryPast, row.dataset.past === "1");
    }

    // Hide month headings whose rows are all filtered out.
    let visible = 0;
    const counts = {};
    for (const head of document.querySelectorAll("[data-month]")) {
      let any = false;
      let el = head.nextElementSibling;
      while (el && !el.hasAttribute("data-month")) {
        if (el.dataset.on && !el.hidden) {
          any = true;
          visible++;
          counts[el.dataset.aud] = (counts[el.dataset.aud] || 0) + 1;
        }
        el = el.nextElementSibling;
      }
      head.hidden = !any;
    }
    for (const el of document.querySelectorAll("[data-count-for]")) {
      el.textContent = counts[el.dataset.countFor] || 0;
    }
  }

  document.querySelectorAll("[data-year]").forEach(btn => {
    btn.addEventListener("click", () => {
      year = btn.dataset.year;
      document.querySelectorAll("[data-year]").forEach(b =>
        b.setAttribute("aria-pressed", String(b === btn)));
      apply();
    });
  });

  const pastBtn = document.getElementById("toggle-past");
  pastBtn.addEventListener("click", () => {
    showPast = !showPast;
    pastBtn.setAttribute("aria-pressed", String(showPast));
    apply();
  });

  const verBtn = document.getElementById("toggle-verified");
  verBtn.addEventListener("click", () => {
    verifiedOnly = !verifiedOnly;
    verBtn.setAttribute("aria-pressed", String(verifiedOnly));
    apply();
  });

  apply();
</script>
