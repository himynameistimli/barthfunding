---
import Base from "../../layouts/Base.astro";
import Rail from "../../components/Rail.astro";
import {
  PROGRAMS, LAST_UPDATED, CAT_LABELS, TYPE_LABELS, FOCUS_LABELS
} from "../../data/programs.mjs";
import { SITE_URL, CONTACT_EMAIL } from "../../data/site.mjs";
import { ENTRIES } from "../../data/calendar.mjs";
import a from "../../styles/app.module.scss";
import c from "../../styles/calendar.module.scss";

// Counts for the legend and the rail note describe the whole dataset; the
// filtered numbers are computed in the browser as the filter changes.
const verified = ENTRIES.filter(e => e.status === "verified").length;
const unconfirmed = ENTRIES.filter(e => e.status === "unconfirmed").length;
const projected = ENTRIES.filter(e => e.status === "projected").length;
const withDates = new Set(ENTRIES.map(e => e.slug)).size;
// webcal:// hands the feed to the OS calendar handler, so it wants a bare host.
const SITE_HOST = SITE_URL.replace(/^https?:\/\//, "");

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Barth syndrome funding deadline calendar",
  url: `${SITE_URL}/calendar/`,
  description:
    "Every dated deadline across Barth syndrome and rare-disease research funding, separated by audience, with subscribable calendar feeds.",
  isPartOf: { "@type": "WebSite", name: "Barth Syndrome Research Funding Index", url: SITE_URL }
};
---
<Base
  title="Funding deadline calendar — Barth syndrome research funding"
  description="Every dated funding deadline through 2027 for Barth syndrome research, advocacy organizations, and families — with subscribable .ics calendar feeds that set their own reminders."
  jsonLd={jsonLd}
>
  <div class={a.shell}>
    <Rail
      headline={`${ENTRIES.length} dated entries`}
      view="calendar"
      showFilters={true}
      headlineNote={`Across ${withDates} programs — ${verified} read off the funder's own page, ${unconfirmed} published but unconfirmed, ${projected} projected from past cycles.`}
    />

    <main class={`${a.doc} ${a.docWide} ${c.page}`}>
      <h1>Funding deadline calendar</h1>

      <p class={c.lede}>
        Every tracked deadline, letter of intent, opening date, and decision. Filter on the
        left and the calendar, the subscription link, and what to do next all follow.
      </p>

      <section class={c.monthView} id="month-view">
        <div class={c.monthBar}>
          <button class={c.monthNav} type="button" id="month-prev" aria-label="Previous month">‹</button>
          <h2 class={c.monthTitle} id="month-title">—</h2>
          <button class={c.monthNav} type="button" id="month-next" aria-label="Next month">›</button>
          <button class={c.chip} type="button" id="month-today">Today</button>
          <span class={c.spacer}></span>
          <button class={c.chip} type="button" data-view="month" aria-pressed="true">Month</button>
          <button class={c.chip} type="button" data-view="list" aria-pressed="false">List</button>
        </div>
        <div class={c.legend}>
          <span class={`${c.legendKey} ${c.audResearchers}`}>Researchers</span>
          <span class={`${c.legendKey} ${c.audOrgs}`}>Advocacy orgs</span>
          <span class={`${c.legendKey} ${c.audPatients}`}>Patients &amp; families</span>
          <span class={c.legendNote}>Outlined = not confirmed at the funder</span>
        </div>
        <div class={c.weekHead} aria-hidden="true">
          <span>Sun</span><span>Mon</span><span>Tue</span><span>Wed</span>
          <span>Thu</span><span>Fri</span><span>Sat</span>
        </div>
        <div class={c.monthGrid} id="month-grid"></div>
        <p class={c.monthEmpty} id="month-empty" hidden>Nothing scheduled this month.</p>
      </section>

      <section class={c.listView} id="list-view" hidden>
        <div id="list-body"></div>
        <p class={c.monthEmpty} id="list-empty" hidden>No dates match this filter.</p>
      </section>

      <section class={c.addBar}>
        <span class={c.ctrlLabel}>Add these dates to</span>
        <a class={c.addBtn} id="add-google" href="#" target="_blank" rel="noopener">Google Calendar</a>
        <a class={c.addBtn} id="add-apple" href="#">Apple Calendar</a>
        <a class={c.addBtn} id="add-outlook" href="#" target="_blank" rel="noopener">Outlook.com</a>
        <a class={c.addBtn} id="add-m365" href="#" target="_blank" rel="noopener">Microsoft 365</a>
        <a class={c.addBtnAlt} id="add-download" href="#" download>Download .ics</a>
        <button class={c.addBtnAlt} type="button" id="add-copy">Copy link</button>
      </section>
      <p class={c.subHint} aria-live="polite" id="copy-status">
        Subscribing keeps up to date on its own and brings reminders. The link follows your
        filter, so you can subscribe to just the slice you care about.
      </p>

      <section class={c.actNow} id="act-now">
        <h2 class={c.boxHead}>What to do next</h2>
        <p class={c.subNote}>The soonest dates in this filter that you can still act on.</p>
        <ul class={c.actList} id="act-list"></ul>
        <p class={c.empty} id="act-empty" hidden>
          Nothing actionable in this filter. Widen it, or scroll the calendar forward.
        </p>
      </section>

      <section class={c.legendSec}>
        <h2>How to read this</h2>
        <div class={c.legendGrid}>
          <p class={c.legendItem}>
            <strong>Verified ({verified})</strong>
            Read directly off the funder's own page on {LAST_UPDATED}. The calendar entry
            records which page, so you can check our work.
          </p>
          <p class={c.legendItem}>
            <strong>Unconfirmed ({unconfirmed})</strong>
            A real published date that we have not confirmed at the source — either the
            funder's own page was unreachable and we are relying on others reporting it, or
            the date came from an earlier pass of this index and has not been re-checked.
          </p>
          <p class={c.legendItem}>
            <strong>Projected ({projected})</strong>
            Inferred from the program's past cycles. The funder has not published this date.
            Treat it as a prompt to go and check, never as a deadline.
          </p>
          <p class={c.legendItem}>
            <strong>NIH dates</strong>
            Standing receipt dates, already shifted off weekends and federal holidays to the
            next business day, as NIH policy requires.
          </p>
        </div>
        <p class={a.note}>
          A program can appear under more than one audience when it genuinely serves both.
          Dates move, and calls are cancelled without notice — confirm on the funder's own
          site before you rely on anything here. Corrections go to{" "}
          <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a> or the{" "}
          <a href="/suggest-update/">suggest an update</a> page.
        </p>
        <p class={a.docFoot}>Deadline data last verified {LAST_UPDATED}.</p>
      </section>
    </main>
  </div>
</Base>

<script define:vars={{ c, s: a, SITE_URL, SITE_HOST, PROGRAMS, CAT_LABELS, TYPE_LABELS, FOCUS_LABELS }}>
  // One filter state drives the grid, the list, the subscribe link, and the
  // what-to-do-next box. The rail markup and filter semantics match the index;
  // audience membership and the search haystack are derived in programs.mjs so
  // the two pages cannot disagree.
  const today = new Date();
  today.setHours(0, 0, 0, 0);
  const iso = d => `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}` +
    `-${String(d.getDate()).padStart(2, "0")}`;
  const todayISO = iso(today);
  const esc = str => String(str ?? "").replace(/[&<>"']/g, ch =>
    ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[ch]));

  const MONTH_NAMES = ["January", "February", "March", "April", "May", "June",
    "July", "August", "September", "October", "November", "December"];
  const MON = MONTH_NAMES.map(m => m.slice(0, 3));
  const KIND_LABEL = { deadline: "Deadline", loi: "Letter of intent", opens: "Opens",
    closes: "Closes", decision: "Decision", start: "Award start", window: "Window" };
  const SOFT = new Set(["decision", "start", "opens", "window"]);
  const AUD_CLASS = { researchers: c.audResearchers, orgs: c.audOrgs, patients: c.audPatients };
  const AUD_WORD = { researchers: "researchers", orgs: "advocacy orgs", patients: "patients & families" };
  const AUD_RANK = ["patients", "orgs", "researchers"];

  const dayDiff = on => {
    const [y, m, d] = on.split("-").map(Number);
    return Math.round((Date.UTC(y, m - 1, d) - Date.UTC(
      today.getFullYear(), today.getMonth(), today.getDate())) / 86400000);
  };
  const plural = (n, w) => `${n} ${w}${n === 1 ? "" : "s"}`;
  const relative = n => {
    if (n === 0) return "today";
    if (n < 0) return `${plural(-n, "day")} ago`;
    if (n === 1) return "tomorrow";
    if (n < 45) return `in ${plural(n, "day")}`;
    return `in ${plural(Math.round(n / 30.4), "month")}`;
  };
  const fmtDate = e => {
    const [y, m, d] = e.on.split("-");
    return e.precision === "month"
      ? `${MONTH_NAMES[Number(m) - 1]} ${y}`
      : `${MON[Number(m) - 1]} ${Number(d)}, ${y}`;
  };

  // --- filter state, mirrored into the URL so a filtered view is shareable ---
  const params = new URLSearchParams(location.search);
  const state = {
    q: params.get("q") || "",
    cat: params.get("cat") || "all",
    aud: params.get("aud") || null,
    type: params.get("type") || null,
    focus: params.get("focus") || null,
    showPast: params.get("past") === "1"
  };

  const audPass = (p, a) => !a || p.auds.includes(a);
  const terms = () => state.q.trim().toLowerCase().split(/\s+/).filter(Boolean);

  function pool(opts = {}) {
    const t = terms();
    return PROGRAMS.filter(p => {
      if (p.expired && !state.showPast && !opts.ignorePast) return false;
      if (!opts.ignoreCat && state.cat !== "all" && p.cat !== state.cat) return false;
      if (!opts.ignoreAud && !audPass(p, state.aud)) return false;
      if (!opts.ignoreType && state.type && p.awardType !== state.type) return false;
      if (!opts.ignoreFocus && state.focus && !(p.focus || []).includes(state.focus)) return false;
      return t.every(x => p.hay.includes(x));
    });
  }

  /** Flatten the filtered programs into dated entries. */
  function entriesOf(programs) {
    const out = [];
    for (const p of programs) {
      for (const d of p.dates || []) {
        out.push({
          ...d,
          kind: d.kind || "deadline",
          precision: d.precision || "day",
          program: p.name,
          slug: p.slug,
          auds: p.auds,
          aud: AUD_RANK.find(x => p.auds.includes(x)) || "researchers",
          soft: SOFT.has(d.kind || "deadline")
        });
      }
    }
    out.sort((x, y) => (x.on < y.on ? -1 : x.on > y.on ? 1 : x.program.localeCompare(y.program)));
    return out;
  }

  let entries = [];

  // --- rail ------------------------------------------------------------------
  function renderRail() {
    const catBase = pool({ ignoreCat: true });
    const cats = [["all", "All sources"], ["government", "Government"], ["nonprofit", "Foundations"],
      ["corporate", "Corporate"], ["general", "General biomedical"]];
    const dated = list => list.filter(p => (p.dates || []).length).length;

    document.getElementById("cat-filters").innerHTML = cats.map(([key, label]) => `
      <button class="${s.railBtn}" data-cat="${key}" aria-pressed="${state.cat === key}" type="button">
        <span>${label}</span><span class="${s.n}">${dated(catBase.filter(p => key === "all" || p.cat === key))}</span>
      </button>`).join("");

    const audBase = pool({ ignoreAud: true });
    const auds = [["", "Everyone"], ["researchers", "Researchers"], ["orgs", "Advocacy orgs"],
      ["patients", "Patients & families"]];
    document.getElementById("aud-filters").innerHTML = auds.map(([key, label]) => `
      <button class="${s.railBtn}" data-aud="${key}" aria-pressed="${(state.aud || "") === key}" type="button">
        <span>${label}</span><span class="${s.n}">${dated(audBase.filter(p => audPass(p, key || null)))}</span>
      </button>`).join("");

    const typeBase = pool({ ignoreType: true });
    document.getElementById("type-filters").innerHTML = Object.entries(TYPE_LABELS).map(([key, label]) => `
      <button class="${s.railBtn}" data-type="${key}" aria-pressed="${state.type === key}" type="button">
        <span>${label}</span><span class="${s.n}">${dated(typeBase.filter(p => p.awardType === key))}</span>
      </button>`).join("");

    const focusBase = pool({ ignoreFocus: true });
    document.getElementById("focus-filters").innerHTML = Object.entries(FOCUS_LABELS).map(([key, label]) => `
      <button class="${s.railBtn}" data-focus="${key}" aria-pressed="${state.focus === key}" type="button">
        <span>${label}</span><span class="${s.n}">${dated(focusBase.filter(p => (p.focus || []).includes(key)))}</span>
      </button>`).join("");

    document.getElementById("status-filters").innerHTML = `
      <button class="${s.railBtn}" data-past="1" aria-pressed="${state.showPast}" type="button">
        <span>Include past programs</span><span class="${s.n}">${PROGRAMS.filter(p => p.expired).length}</span>
      </button>`;

    const active = (state.cat !== "all" ? 1 : 0) + (state.aud ? 1 : 0) + (state.type ? 1 : 0)
      + (state.focus ? 1 : 0) + (state.showPast ? 1 : 0);
    const ft = document.getElementById("filters-toggle");
    if (ft) ft.textContent = active ? `Filters · ${active}` : "Filters";

    document.querySelectorAll("[data-cat]").forEach(b => b.onclick = () => { state.cat = b.dataset.cat; render(); });
    document.querySelectorAll("[data-aud]").forEach(b => b.onclick = () => { state.aud = b.dataset.aud || null; render(); });
    document.querySelectorAll("[data-type]").forEach(b => b.onclick = () => { state.type = state.type === b.dataset.type ? null : b.dataset.type; render(); });
    document.querySelectorAll("[data-focus]").forEach(b => b.onclick = () => { state.focus = state.focus === b.dataset.focus ? null : b.dataset.focus; render(); });
    document.querySelector("[data-past]").onclick = () => { state.showPast = !state.showPast; render(); };
  }

  // --- month grid ------------------------------------------------------------
  const gridEl = document.getElementById("month-grid");
  const titleEl = document.getElementById("month-title");
  const monthEmpty = document.getElementById("month-empty");
  const monthKeyOf = d => `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}`;
  let cursor = monthKeyOf(today);

  function chipHTML(e) {
    const cls = [c.chipEvent, AUD_CLASS[e.aud] || "", e.status !== "verified" ? c.chipTentative : ""]
      .filter(Boolean).join(" ");
    const title = `${e.program} — ${e.label}` +
      (e.status !== "verified" ? ` (${e.status})` : "") +
      `\nFor: ${e.auds.map(x => AUD_WORD[x]).join(", ")}`;
    return `<a class="${cls}" href="/grants/${e.slug}/" title="${esc(title)}">` +
      `<span class="${c.chipDot}"></span>${esc(e.program)}</a>`;
  }

  function renderMonth() {
    const [y, m] = cursor.split("-").map(Number);
    titleEl.textContent = `${MONTH_NAMES[m - 1]} ${y}`;
    const byDay = new Map();
    for (const e of entries) {
      if (!byDay.has(e.on)) byDay.set(e.on, []);
      byDay.get(e.on).push(e);
    }
    const daysInMonth = new Date(Date.UTC(y, m, 0)).getUTCDate();
    const lead = new Date(Date.UTC(y, m - 1, 1)).getUTCDay();
    const cells = [];
    for (let i = 0; i < lead; i++) cells.push(null);
    for (let d = 1; d <= daysInMonth; d++) cells.push(d);
    while (cells.length % 7 !== 0) cells.push(null);

    let shown = 0;
    gridEl.innerHTML = cells.map(d => {
      if (d === null) return `<div class="${c.day} ${c.dayBlank}"></div>`;
      const on = `${cursor}-${String(d).padStart(2, "0")}`;
      const items = byDay.get(on) || [];
      shown += items.length;
      const cls = [c.day, on === todayISO ? c.dayToday : "", on < todayISO ? c.dayPast : ""]
        .filter(Boolean).join(" ");
      return `<div class="${cls}"><span class="${c.dayNum}">${d}</span>` +
        `<div class="${c.dayItems}">${items.map(chipHTML).join("")}</div></div>`;
    }).join("");
    monthEmpty.hidden = shown > 0;
  }

  function shiftMonth(delta) {
    const [y, m] = cursor.split("-").map(Number);
    cursor = monthKeyOf(new Date(y, m - 1 + delta, 1));
    renderMonth();
  }
  document.getElementById("month-prev").onclick = () => shiftMonth(-1);
  document.getElementById("month-next").onclick = () => shiftMonth(1);
  document.getElementById("month-today").onclick = () => { cursor = monthKeyOf(today); renderMonth(); };

  // --- list ------------------------------------------------------------------
  const listBody = document.getElementById("list-body");
  const listEmpty = document.getElementById("list-empty");

  function renderList() {
    const future = entries.filter(e => e.on >= todayISO);
    listEmpty.hidden = future.length > 0;
    const groups = new Map();
    for (const e of future) {
      const k = e.on.slice(0, 7);
      if (!groups.has(k)) groups.set(k, []);
      groups.get(k).push(e);
    }
    listBody.innerHTML = [...groups.entries()].map(([k, items]) => {
      const [y, m] = k.split("-");
      return `<h3 class="${c.monthHead}">${MONTH_NAMES[Number(m) - 1]} ${y}</h3>` +
        items.map(e => {
          const statusCls = e.status === "verified" ? c.tagVerified
            : e.status === "unconfirmed" ? c.tagUnconfirmed : c.tagProjected;
          const statusWord = e.status === "verified" ? "Verified"
            : e.status === "unconfirmed" ? "Unconfirmed" : "Projected";
          return `<article class="${c.entry}">
            <div class="${c.when}">${esc(fmtDate(e))}
              <span class="${c.days}">${relative(dayDiff(e.on))}</span></div>
            <div class="${c.body}">
              <p class="${c.prog}"><a href="/grants/${e.slug}/">${esc(e.program)}</a></p>
              <p class="${c.what}">${esc(e.label)}</p>
              ${e.note ? `<p class="${c.note}">${esc(e.note)}</p>` : ""}
            </div>
            <div class="${c.flags}">
              <span class="${c.tag} ${c.tagKind}">${KIND_LABEL[e.kind]}</span>
              <span class="${c.tag} ${statusCls}">${statusWord}</span>
            </div>
          </article>`;
        }).join("");
    }).join("");
  }

  // --- what to do next -------------------------------------------------------
  const actList = document.getElementById("act-list");
  const actEmpty = document.getElementById("act-empty");

  function renderActNow() {
    const upcoming = entries.filter(e => !e.soft && e.on >= todayISO).slice(0, 8);
    actEmpty.hidden = upcoming.length > 0;
    actList.innerHTML = upcoming.map(e => {
      const n = dayDiff(e.on);
      const mark = e.status === "verified" ? "" : ` (${e.status})`;
      return `<li class="${c.actItem}">
        <span class="${c.actDays} ${n <= 21 ? c.actSoon : ""}">${relative(n)}</span>
        <span><a href="/grants/${e.slug}/">${esc(e.program)}</a> — ${esc(e.label)}${mark}
          <span class="${c.actWhen}">${esc(fmtDate(e))}</span></span>
      </li>`;
    }).join("");
  }

  // --- subscribe -------------------------------------------------------------
  const copyStatus = document.getElementById("copy-status");
  const statusDefault = copyStatus.textContent;
  const copyBtn = document.getElementById("add-copy");
  const copyDefault = copyBtn.textContent;

  function filterQS() {
    const qs = new URLSearchParams();
    if (state.aud) qs.set("aud", state.aud);
    if (state.cat !== "all") qs.set("cat", state.cat);
    if (state.type) qs.set("type", state.type);
    if (state.focus) qs.set("focus", state.focus);
    if (state.q.trim()) qs.set("q", state.q.trim());
    if (state.showPast) qs.set("past", "1");
    return qs;
  }

  function feedPath() {
    const qs = filterQS().toString();
    // With no filter the prebuilt static feed is cheaper than the function.
    return qs ? `/calendar/feed.ics?${qs}` : "/calendar/all.ics";
  }

  function syncSubscribe() {
    const path = feedPath();
    const https = `${SITE_URL}${path}`;
    const webcal = `webcal://${SITE_HOST}${path}`;
    const name = "Barth funding deadlines";
    document.getElementById("add-google").href =
      `https://calendar.google.com/calendar/r?cid=${encodeURIComponent(webcal)}`;
    document.getElementById("add-apple").href = webcal;
    document.getElementById("add-outlook").href =
      "https://outlook.live.com/calendar/0/addfromweb?url=" +
      encodeURIComponent(https) + "&name=" + encodeURIComponent(name);
    document.getElementById("add-m365").href =
      "https://outlook.office.com/calendar/0/addfromweb?url=" +
      encodeURIComponent(https) + "&name=" + encodeURIComponent(name);
    const dl = document.getElementById("add-download");
    dl.href = https;
    dl.setAttribute("download", "barth-funding.ics");
    copyBtn.dataset.url = https;
  }

  async function copyText(text) {
    try {
      await navigator.clipboard.writeText(text);
      return true;
    } catch {
      const ta = document.createElement("textarea");
      ta.value = text;
      ta.setAttribute("readonly", "");
      ta.style.cssText = "position:fixed;top:-1000px;opacity:0";
      document.body.appendChild(ta);
      ta.select();
      let ok = false;
      try { ok = document.execCommand("copy"); } catch { ok = false; }
      ta.remove();
      return ok;
    }
  }

  let resetTimer;
  copyBtn.addEventListener("click", async () => {
    const url = copyBtn.dataset.url;
    const ok = await copyText(url);
    clearTimeout(resetTimer);
    copyBtn.textContent = ok ? "Copied ✓" : "Select it below";
    copyStatus.textContent = "";
    if (ok) {
      copyStatus.textContent = `Copied ${url} — paste it into your calendar app as a new subscription.`;
    } else {
      // Clipboard access can be blocked outright; put the address on the page
      // and select it so the keyboard shortcut has something to act on.
      copyStatus.append("Copy this address: ");
      const code = document.createElement("code");
      code.textContent = url;
      copyStatus.append(code);
      const r = document.createRange();
      r.selectNodeContents(code);
      const sel = window.getSelection();
      sel.removeAllRanges();
      sel.addRange(r);
    }
    resetTimer = setTimeout(() => {
      copyBtn.textContent = copyDefault;
      copyStatus.textContent = statusDefault;
    }, 8000);
  });

  // --- view switch -----------------------------------------------------------
  const monthView = document.getElementById("month-view");
  const listView = document.getElementById("list-view");
  let view = "month";
  function setView(v) {
    view = v;
    monthView.hidden = v !== "month";
    listView.hidden = v !== "list";
    for (const b of document.querySelectorAll("[data-view]")) {
      b.setAttribute("aria-pressed", String(b.dataset.view === v));
    }
  }
  for (const b of document.querySelectorAll("[data-view]")) {
    b.addEventListener("click", () => setView(b.dataset.view));
  }

  // --- render ----------------------------------------------------------------
  const countEl = document.getElementById("count");
  const qEl = document.getElementById("q");

  function render() {
    const programs = pool();
    entries = entriesOf(programs);
    const withDates = programs.filter(p => (p.dates || []).length).length;

    if (countEl) {
      countEl.textContent = `${entries.length} DATE${entries.length === 1 ? "" : "S"} · ` +
        `${withDates} OF ${programs.length} PROGRAMS`;
    }

    renderMonth();
    renderList();
    renderActNow();
    syncSubscribe();
    renderRail();

    const qs = filterQS().toString();
    history.replaceState(null, "", qs ? `?${qs}` : location.pathname);
  }

  if (qEl) {
    qEl.value = state.q;
    qEl.addEventListener("input", () => { state.q = qEl.value; render(); });
  }

  setView("month");
  render();
</script>
