---
import Base from "../layouts/Base.astro";
import Rail from "../components/Rail.astro";
import s from "../styles/app.module.scss";
import { CONTACT_EMAIL } from "../data/site.mjs";
import { LAST_UPDATED } from "../data/programs.mjs";
import { SITE_URL } from "../data/site.mjs";
const mailto = `mailto:${CONTACT_EMAIL}?subject=${encodeURIComponent("Funding index update request")}`;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  name: "Suggest an update",
  url: `${SITE_URL}/suggest-update/`
};
---
<Base
  title="Suggest an update"
  description="Report a changed deadline, broken link, or missing program in the Barth syndrome funding index."
  jsonLd={jsonLd}
>
  <div class={s.shell}>
    <Rail />
    <main class={s.doc}>
      <p class={s.crumb}><a href="/">← Funding index</a></p>
      <h1>Suggest an update</h1>
      <p class={s.sponsor}>Help keep the index accurate</p>

      <p class={s.proseP} style="margin-top: 20px;">Deadlines change and programs open, pause, and close. If an entry is wrong or a program is missing, send a correction.</p>

      <h2>What to send</h2>
      <ul>
        <li><strong>A correction</strong> — which program, what's wrong (deadline, amount, eligibility, dead link), and a source URL if there is one.</li>
        <li><strong>A new program</strong> — name, funder, a link, and roughly who can apply.</li>
        <li><strong>A change request</strong> — anything about the index itself that would make it more useful.</li>
      </ul>

      <h2>Where to send it</h2>
      <p class={s.proseP}><a href={mailto}>{CONTACT_EMAIL}</a> — every program page also carries a “Suggest an update to this entry” link that pre-fills the program name.</p>

      <p class={s.docFoot}>Index last updated {LAST_UPDATED}.</p>
    </main>
  </div>
</Base>
