---
import Base from "../layouts/Base.astro";
import Rail from "../components/Rail.astro";
import { CONTACT_EMAIL } from "../data/site.mjs";
import { LAST_UPDATED } from "../data/programs.mjs";
const mailto = `mailto:${CONTACT_EMAIL}?subject=${encodeURIComponent("Funding index update request")}`;
---
<Base
  title="Suggest an update"
  description="Report a changed deadline, broken link, or missing program in the Barth syndrome funding index."
>
  <div class="shell">
    <Rail />
    <main class="doc">
      <p class="crumb"><a href="/">← Funding index</a></p>
      <h1>Suggest an update</h1>
      <p class="sponsor">Help keep the index accurate</p>

      <p class="prose-p" style="margin-top: 20px;">Grant deadlines shift, programs pause, and new opportunities appear. If something here is wrong — or a program is missing — send it over and it will be corrected.</p>

      <h2>What to send</h2>
      <ul>
        <li><strong>A correction</strong> — which program, what's wrong (deadline, amount, eligibility, dead link), and a source URL if there is one.</li>
        <li><strong>A new program</strong> — name, funder, a link, and roughly who can apply.</li>
        <li><strong>A change request</strong> — anything about the index itself that would make it more useful.</li>
      </ul>

      <h2>Where to send it</h2>
      <p class="prose-p"><a href={mailto}>{CONTACT_EMAIL}</a> — every program page also carries a “Suggest an update to this entry” link that pre-fills the program name.</p>

      <p class="doc-foot">Index last updated {LAST_UPDATED}.</p>
    </main>
  </div>
</Base>
