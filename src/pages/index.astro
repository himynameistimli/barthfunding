---
import Base from "../layouts/Base.astro";
import Rail from "../components/Rail.astro";
import s from "../styles/app.module.scss";
import { PROGRAMS, AWARD_MAX_USD, CAT_LABELS, TYPE_LABELS, FOCUS_LABELS } from "../data/programs.mjs";
import { SITE_URL, SITE_NAME } from "../data/site.mjs";

// Headline counts only programs a researcher can still apply to.
const expiredNames = new Set(PROGRAMS.filter(p => p.expired).map(p => p.name));
const totalUSD = Object.entries(AWARD_MAX_USD)
  .filter(([name]) => !expiredNames.has(name))
  .reduce((sum, [, v]) => sum + v, 0);
const headlineTotal = "$" + Math.floor(totalUSD / 1e6) + "M+";

const CAT_META = {
  government: { code: "GOV", label: "Government" },
  nonprofit: { code: "FDN", label: "Foundation / non-profit" },
  corporate: { code: "CORP", label: "Corporate / industry" },
  general: { code: "GEN", label: "General biomedical" }
};

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: SITE_NAME,
    url: SITE_URL,
    description: `A maintained index of ${PROGRAMS.length} funding programs open to researchers and organizations working on Barth syndrome.`
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: "Barth syndrome research funding programs",
    numberOfItems: PROGRAMS.length,
    itemListElement: PROGRAMS.map((p, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: p.name,
      url: `${SITE_URL}/grants/${p.slug}/`
    }))
  }
];
---
<Base
  title="Barth Syndrome Research Funding Index"
  description={`${headlineTotal} in grants, fellowships, and support programs open to researchers and organizations working on Barth syndrome.`}
  jsonLd={jsonLd}
>
  <div class={s.shell}>
    <Rail headline={headlineTotal} showFilters={true} />

    <main style="min-width: 0;">
      <div class={s.tblHead}>
        <span class={s.lblMuted}>No.</span>
        <button id="sort-name" type="button">Program <span class="arrow"></span></button>
        <button id="sort-award" class={s.taR} type="button">Award max <span class="arrow"></span></button>
        <button id="sort-deadline" class={s.colDeadline} type="button">Deadline <span class="arrow"></span></button>
        <span class={`${s.lblMuted} ${s.taR}`}>Src</span>
      </div>
      <div id="rows"></div>
    </main>
  </div>

  <div id="drawer-root"></div>

  <script define:vars={{ PROGRAMS, AWARD_MAX_USD, CAT_META, CAT_LABELS, TYPE_LABELS, FOCUS_LABELS, s }}>
    const rowsEl = document.getElementById("rows");
    const countEl = document.getElementById("count");
    const qEl = document.getElementById("q");
    const drawerRoot = document.getElementById("drawer-root");

    // Category → the module class carrying that category's colour.
    const srcClass = cat => s["src" + cat.charAt(0).toUpperCase() + cat.slice(1)] || "";

    let state = { q: "", cat: "all", aud: null, type: null, focus: null, showPast: false, sort: "award", dir: "desc" };

    const esc = str => String(str ?? "").replace(/[&<>"']/g, c =>
      ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));

    function highlight(text, terms) {
      let out = esc(text);
      for (const t of terms) {
        const re = new RegExp("(" + t.replace(/[.*+?^${}()|[\]\\]/g, "\\$&") + ")", "gi");
        out = out.replace(re, "<mark>$1</mark>");
      }
      return out;
    }

    const hay = p => [p.name, p.sponsor, p.desc, p.eligibility, p.apply, p.amount, p.deadline,
      (p.tags || []).join(" "), CAT_LABELS[p.cat] || "", TYPE_LABELS[p.awardType] || "",
      (p.focus || []).map(f => FOCUS_LABELS[f]).join(" ")].join(" ").toLowerCase();

    const audPass = (p, a) => {
      if (!a) return true;
      const tags = p.tags || [];
      const isOrg = tags.includes("for organizations");
      return a === "orgs" ? isOrg : (!isOrg || tags.includes("for researchers"));
    };

    function parseDeadline(str) {
      if (!str) return Infinity;
      const m = String(str).match(/(Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)[a-z.]*\s+(\d{1,2}),?\s+(\d{4})/);
      if (m) return new Date(m[3] + " " + m[1] + " " + m[2]).getTime();
      const y = String(str).match(/\b(20\d\d)\b/);
      if (y) return new Date(y[1] + "-06-30").getTime();
      return Infinity;
    }

    function fmtUSD(v) {
      if (!v) return "—";
      if (v >= 1e6) return "$" + (Math.round(v / 1e5) / 10).toFixed(v % 1e6 ? 1 : 0).replace(/\.0$/, "") + "M";
      return "$" + Math.round(v / 1e3) + "K";
    }

    const shortDeadline = str => {
      if (!str) return "—";
      const t = String(str);
      return t.length > 64 ? t.slice(0, 61).replace(/[,;\s]+\S*$/, "") + "…" : t;
    };

    const terms = () => state.q.trim().toLowerCase().split(/\s+/).filter(Boolean);

    // Programs passing every facet except the one being counted.
    function pool(opts = {}) {
      const t = terms();
      return PROGRAMS.filter(p => {
        if (p.expired && !state.showPast && !opts.ignorePast) return false;
        if (!opts.ignoreCat && state.cat !== "all" && p.cat !== state.cat) return false;
        if (!opts.ignoreAud && !audPass(p, state.aud)) return false;
        if (!opts.ignoreType && state.type && p.awardType !== state.type) return false;
        if (!opts.ignoreFocus && state.focus && !(p.focus || []).includes(state.focus)) return false;
        return t.every(x => hay(p).includes(x));
      });
    }

    function sortRows(list) {
      const sgn = state.dir === "asc" ? 1 : -1;
      return list.slice().sort((a, b) => {
        if (state.sort === "name") return sgn * a.name.localeCompare(b.name);
        if (state.sort === "award") {
          const av = AWARD_MAX_USD[a.name] || 0, bv = AWARD_MAX_USD[b.name] || 0;
          return sgn * (av - bv) || a.name.localeCompare(b.name);
        }
        const ad = parseDeadline(a.deadline), bd = parseDeadline(b.deadline);
        if (ad === bd) return a.name.localeCompare(b.name);
        if (ad === Infinity) return 1;
        if (bd === Infinity) return -1;
        return sgn * (ad - bd);
      });
    }

    function renderRail() {
      const catBase = pool({ ignoreCat: true });
      const cats = [["all", "All sources"], ["government", "Government"], ["nonprofit", "Foundations"],
        ["corporate", "Corporate"], ["general", "General biomedical"]];
      document.getElementById("cat-filters").innerHTML = cats.map(([key, label]) => `
        <button class="${s.railBtn}" data-cat="${key}" aria-pressed="${state.cat === key}" type="button">
          <span>${label}</span><span class="${s.n}">${catBase.filter(p => key === "all" || p.cat === key).length}</span>
        </button>`).join("");

      const audBase = pool({ ignoreAud: true });
      const auds = [["", "Everyone"], ["researchers", "Researchers"], ["orgs", "Advocacy orgs"]];
      document.getElementById("aud-filters").innerHTML = auds.map(([key, label]) => `
        <button class="${s.railBtn}" data-aud="${key}" aria-pressed="${(state.aud || "") === key}" type="button">
          <span>${label}</span><span class="${s.n}">${audBase.filter(p => audPass(p, key || null)).length}</span>
        </button>`).join("");

      const typeBase = pool({ ignoreType: true });
      document.getElementById("type-filters").innerHTML = Object.entries(TYPE_LABELS).map(([key, label]) => `
        <button class="${s.railBtn}" data-type="${key}" aria-pressed="${state.type === key}" type="button">
          <span>${label}</span><span class="${s.n}">${typeBase.filter(p => p.awardType === key).length}</span>
        </button>`).join("");

      const focusBase = pool({ ignoreFocus: true });
      document.getElementById("focus-filters").innerHTML = Object.entries(FOCUS_LABELS).map(([key, label]) => `
        <button class="${s.railBtn}" data-focus="${key}" aria-pressed="${state.focus === key}" type="button">
          <span>${label}</span><span class="${s.n}">${focusBase.filter(p => (p.focus || []).includes(key)).length}</span>
        </button>`).join("");

      document.getElementById("status-filters").innerHTML = `
        <button class="${s.railBtn}" data-past="1" aria-pressed="${state.showPast}" type="button">
          <span>Include past programs</span><span class="${s.n}">${PROGRAMS.filter(p => p.expired).length}</span>
        </button>`;

      document.querySelectorAll("[data-cat]").forEach(b => b.onclick = () => { state.cat = b.dataset.cat; render(); });
      document.querySelectorAll("[data-aud]").forEach(b => b.onclick = () => { state.aud = b.dataset.aud || null; render(); });
      document.querySelectorAll("[data-type]").forEach(b => b.onclick = () => { state.type = state.type === b.dataset.type ? null : b.dataset.type; render(); });
      document.querySelectorAll("[data-focus]").forEach(b => b.onclick = () => { state.focus = state.focus === b.dataset.focus ? null : b.dataset.focus; render(); });
      document.querySelector("[data-past]").onclick = () => { state.showPast = !state.showPast; render(); };
    }

    function render() {
      const t = terms();
      const list = sortRows(pool());
      const poolCount = PROGRAMS.filter(p => !p.expired || state.showPast).length;

      countEl.textContent = (list.length === poolCount
        ? poolCount + " PROGRAMS"
        : list.length + " OF " + poolCount + " PROGRAMS")
        + (state.showPast ? "" : " · " + PROGRAMS.filter(p => p.expired).length + " PAST HIDDEN");

      rowsEl.innerHTML = list.length ? list.map((p, i) => {
        const meta = CAT_META[p.cat] || { code: "—" };
        return `
        <button class="${s.row}${p.expired ? " " + s.isPast : ""}" data-slug="${esc(p.slug)}" type="button">
          <span class="${s.num}">${String(i + 1).padStart(2, "0")}</span>
          <span style="min-width:0">
            <span class="${s.name}">${highlight(p.name, t)}${p.expired ? `<span class="${s.tagPast}">PAST</span>` : ""}</span>
            <span class="${s.sponsor}">${highlight(p.sponsor, t)}</span>
            <span class="${s.deadlineInline}">${highlight(shortDeadline(p.deadline), t)}</span>
          </span>
          <span class="${s.award}">${fmtUSD(AWARD_MAX_USD[p.name])}</span>
          <span class="${s.deadline} ${s.colDeadline}">${highlight(shortDeadline(p.deadline), t)}</span>
          <span class="${s.src} ${srcClass(p.cat)}">${meta.code}</span>
        </button>`;
      }).join("") : `<div class="${s.empty}"><strong>No programs match.</strong>Try a broader term — “mitochondrial”, “pilot”, or “fellowship”.</div>`;

      rowsEl.querySelectorAll("[data-slug]").forEach(r => {
        r.onclick = () => { location.hash = r.dataset.slug; };
      });

      const arrows = { name: "sort-name", award: "sort-award", deadline: "sort-deadline" };
      for (const [key, id] of Object.entries(arrows)) {
        document.querySelector(`#${id} .arrow`).textContent =
          state.sort === key ? (state.dir === "asc" ? "↑" : "↓") : "";
      }
      renderRail();
    }

    function setSort(k) {
      if (state.sort === k) state.dir = state.dir === "asc" ? "desc" : "asc";
      else { state.sort = k; state.dir = k === "award" ? "desc" : "asc"; }
      render();
    }
    document.getElementById("sort-name").onclick = () => setSort("name");
    document.getElementById("sort-award").onclick = () => setSort("award");
    document.getElementById("sort-deadline").onclick = () => setSort("deadline");

    qEl.addEventListener("input", () => { state.q = qEl.value; render(); });
    const initialQ = new URLSearchParams(location.search).get("q");
    if (initialQ) { qEl.value = initialQ; state.q = initialQ; }

    /* ---------- drawer, driven by the URL hash so links are shareable ---------- */
    function renderDrawer() {
      const slug = decodeURIComponent(location.hash.replace(/^#/, ""));
      const p = PROGRAMS.find(x => x.slug === slug);
      if (!p) { drawerRoot.innerHTML = ""; document.body.style.overflow = ""; return; }
      const meta = CAT_META[p.cat] || { code: "—", label: "" };
      drawerRoot.innerHTML = `
        <button class="${s.scrim}" id="scrim" aria-label="Close details" type="button"></button>
        <div class="${s.drawer}" role="dialog" aria-modal="true" aria-label="${esc(p.name)}">
          <div class="${s.drawerTop}">
            <span class="${s.drawerCat} ${srcClass(p.cat)}">${meta.code} — ${esc(meta.label.toUpperCase())}</span>
            <button class="${s.drawerClose}" id="drawer-close" type="button">Close ✕</button>
          </div>
          <h2>${esc(p.name)}</h2>
          <p class="${s.sponsor}">${esc(p.sponsor)}</p>
          ${p.expired ? `<div class="${s.pastBanner}">This application window has closed. Kept for reference — check the funder's page for a future cycle.</div>` : ""}
          <div class="${s.facts}">
            <div class="${s.fact}"><div class="${s.factK}">Award</div><div class="${s.factV}">${esc(p.amount || "—")}</div></div>
            <div class="${s.fact}"><div class="${s.factK}">Deadline</div><div class="${s.factV}">${esc(p.deadline || "—")}</div></div>
            <div class="${s.fact}"><div class="${s.factK}">Award type</div><div class="${s.factV}">${esc(TYPE_LABELS[p.awardType] || "—")}</div></div>
            <div class="${s.fact}"><div class="${s.factK}">Focus</div><div class="${s.factV}">${esc((p.focus || []).map(f => FOCUS_LABELS[f]).join(" · ") || "—")}</div></div>
          </div>
          <p class="${s.lede}">${esc(p.desc)}</p>
          <div class="${s.sec}"><div class="${s.secH}">Who can apply</div><p>${esc(p.eligibility)}</p></div>
          <div class="${s.sec}"><div class="${s.secH}">How to apply</div><p>${esc(p.apply)}</p></div>
          <div class="${s.sec}">
            <div class="${s.secH}">Links</div>
            <div class="${s.links}">
              ${(p.links || []).map(l => `<a href="${esc(l.url)}" target="_blank" rel="noopener">${esc(l.label)} ↗</a>`).join("")}
              <a href="/grants/${esc(p.slug)}/">Open full page — permanent link</a>
            </div>
          </div>
        </div>`;
      document.body.style.overflow = "hidden";
      const close = () => { history.pushState("", document.title, location.pathname + location.search); renderDrawer(); };
      document.getElementById("scrim").onclick = close;
      document.getElementById("drawer-close").onclick = close;
    }
    window.addEventListener("hashchange", renderDrawer);
    window.addEventListener("keydown", e => {
      if (e.key === "Escape" && location.hash) {
        history.pushState("", document.title, location.pathname + location.search);
        renderDrawer();
      }
    });

    render();
    renderDrawer();
  </script>
</Base>
